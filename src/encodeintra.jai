vp8_clamp_mv2_in_encodeintra :: (mv: *Int_Mv_in_mv, xd: *MACROBLOCKD_in_blockd) {
    if cast,no_check(s32) mv.as_mv.col < xd.mb_to_left_edge - (cast(s32) 16) << 3 {
        mv.as_mv.col = cast,no_check(s16) (xd.mb_to_left_edge - (cast(s32) 16) << 3);
    } else if cast,no_check(s32) mv.as_mv.col > xd.mb_to_right_edge + (cast(s32) 16) << 3 {
        mv.as_mv.col = cast,no_check(s16) (xd.mb_to_right_edge + (cast(s32) 16) << 3);
    }

    if cast,no_check(s32) mv.as_mv.row < xd.mb_to_top_edge - (cast(s32) 16) << 3 {
        mv.as_mv.row = cast,no_check(s16) (xd.mb_to_top_edge - (cast(s32) 16) << 3);
    } else if cast,no_check(s32) mv.as_mv.row > xd.mb_to_bottom_edge + (cast(s32) 16) << 3 {
        mv.as_mv.row = cast,no_check(s16) (xd.mb_to_bottom_edge + (cast(s32) 16) << 3);
    }
}

vp8_clamp_mv_in_encodeintra :: (
    mv: *Int_Mv_in_mv,
    mb_to_left_edge: s32,
    mb_to_right_edge: s32,
    mb_to_top_edge: s32,
    mb_to_bottom_edge: s32
) {
    mv.as_mv.col =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.col < mb_to_left_edge then mb_to_left_edge else cast,no_check(s32) mv.as_mv.col));
    mv.as_mv.col =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.col > mb_to_right_edge then mb_to_right_edge else cast,no_check(s32) mv.as_mv.col));
    mv.as_mv.row =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.row < mb_to_top_edge then mb_to_top_edge else cast,no_check(s32) mv.as_mv.row));
    mv.as_mv.row =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.row > mb_to_bottom_edge then mb_to_bottom_edge else cast,no_check(s32) mv.as_mv.row));
}

vp8_check_mv_bounds_in_encodeintra :: (
    mv: *Int_Mv_in_mv,
    mb_to_left_edge: s32,
    mb_to_right_edge: s32,
    mb_to_top_edge: s32,
    mb_to_bottom_edge: s32
) -> u32 {
    need_to_clamp := cast(u32) (cast,no_check(s32) mv.as_mv.col < mb_to_left_edge);
    need_to_clamp |= cast(u32) (cast,no_check(s32) mv.as_mv.col > mb_to_right_edge);
    need_to_clamp |= cast(u32) (cast,no_check(s32) mv.as_mv.row < mb_to_top_edge);
    need_to_clamp |= cast(u32) (cast,no_check(s32) mv.as_mv.row > mb_to_bottom_edge);
    return need_to_clamp;
}

left_block_mv_in_encodeintra :: (cur_mb: *MODE_INFO_in_blockd, b: s32) -> u32 {
    if b & 3 == 0 {
        cur_mb -= 1;

        if cur_mb.mbmi.mode != cast,no_check(u8) SPLITMV {
            return cur_mb.mbmi.mv.as_int;
        }
        b += 4;
    }

    return (((cur_mb.bmi.data + b - 1)).mv).as_int;
}

above_block_mv_in_encodeintra :: (cur_mb: *MODE_INFO_in_blockd, b: s32, mi_stride: s32) -> u32 {
    if b >> 2 == 0 {
        cur_mb -= mi_stride;

        if cur_mb.mbmi.mode != cast,no_check(u8) SPLITMV {
            return cur_mb.mbmi.mv.as_int;
        }
        b += 16;
    }

    return (((cur_mb.bmi.data + (b - 4))).mv).as_int;
}

left_block_mode_in_encodeintra :: (cur_mb: *MODE_INFO_in_blockd, b: s32) -> B_PREDICTION_MODE {
    if b & 3 == 0 {
        cur_mb -= 1;
        if cast,no_check(s32) cur_mb.mbmi.mode == {
            case B_PRED;
                return ((cur_mb.bmi.data + b + 3)).as_mode;
            case DC_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
            case V_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_VE_PRED;
            case H_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_HE_PRED;
            case TM_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_TM_PRED;
            case;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
        }
    }

    return ((cur_mb.bmi.data + b - 1)).as_mode;
}

above_block_mode_in_encodeintra :: (cur_mb: *MODE_INFO_in_blockd, b: s32, mi_stride: s32) -> B_PREDICTION_MODE {
    if b >> 2 == 0 {
        cur_mb -= mi_stride;

        if cast,no_check(s32) cur_mb.mbmi.mode == {
            case B_PRED;
                return ((cur_mb.bmi.data + b + 12)).as_mode;
            case DC_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
            case V_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_VE_PRED;
            case H_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_HE_PRED;
            case TM_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_TM_PRED;
            case;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
        }
    }

    return ((cur_mb.bmi.data + b - 4)).as_mode;
}

eob_adjust_in_encodeintra :: (eobs: *s8, diff: *s16) {
    for js: 0..cast(s32) 16 - 1 {
        if eobs[js] == 0 && diff[0] != 0 {
            eobs[js] += 1;
        }
        diff += 16;
    }
}

vp8_inverse_transform_mby_in_encodeintra :: (xd: *MACROBLOCKD_in_blockd) {
    dqc := xd.dequant_y1.data;

    if xd.mode_info_context.mbmi.mode != cast,no_check(u8) SPLITMV {
        if xd.eobs[24] > 1 {
            vp8_short_inv_walsh4x4_c(*xd.block[24].dqcoeff[0], xd.qcoeff.data);
        } else {
            vp8_short_inv_walsh4x4_1_c(*xd.block[24].dqcoeff[0], xd.qcoeff.data);
        }
        eob_adjust_in_encodeintra(xd.eobs.data, xd.qcoeff.data);

        dqc = xd.dequant_y1_dc.data;
    }
    vp8_dequant_idct_add_y_block_c(xd.qcoeff.data, dqc, xd.dst.y_buffer, xd.dst.y_stride, xd.eobs.data);
}

vp8_encode_intra :: (x: *MACROBLOCK_in_block, use_dc_pred: s32) -> s32 {
    intra_pred_var: s32 = 0;

    if use_dc_pred != 0 {
        x.e_mbd.mode_info_context.mbmi.mode = cast,no_check(u8) DC_PRED;
        x.e_mbd.mode_info_context.mbmi.uv_mode = cast,no_check(u8) DC_PRED;
        x.e_mbd.mode_info_context.mbmi.ref_frame = cast,no_check(u8) INTRA_FRAME;

        vp8_encode_intra16x16mby(x);

        vp8_inverse_transform_mby_in_encodeintra(*x.e_mbd);
    } else {
        for i: 0..cast(s32) 16 - 1 {
            x.e_mbd.block[i].bmi.as_mode = cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
            vp8_encode_intra4x4block(x, i);
        }
    }

    intra_pred_var = cast,no_check(s32) get_mb_ss_c(x.src_diff.data);

    return intra_pred_var;
}

vp8_encode_intra4x4block :: (x: *MACROBLOCK_in_block, ib: s32) {
    b := x.e_mbd.block.data + ib;
    be := x.block.data + ib;
    dst_stride := x.e_mbd.dst.y_stride;
    dst: *u8 = x.e_mbd.dst.y_buffer + b.offset;
    above := dst - dst_stride;
    yleft := dst - 1;
    top_left := above[-1];

    vp8_intra4x4_predict(above, yleft, dst_stride, b.bmi.as_mode, b.predictor, 16, top_left);

    vp8_subtract_b(be, b, 16);

    x.short_fdct4x4(be.src_diff, be.coeff, 32);

    x.quantize_b(be, b);

    if b.eob.* > 1 {
        vp8_short_idct4x4llm_c(b.dqcoeff, b.predictor, 16, dst, dst_stride);
    } else {
        vp8_dc_only_idct_add_c(b.dqcoeff[0], b.predictor, 16, dst, dst_stride);
    }
}

vp8_encode_intra16x16mby :: (x: *MACROBLOCK_in_block) {
    b := x.block.data + 0;
    xd := *x.e_mbd;

    vp8_build_intra_predictors_mby_s(
        xd,
        xd.dst.y_buffer - xd.dst.y_stride,
        xd.dst.y_buffer - 1,
        xd.dst.y_stride,
        xd.dst.y_buffer,
        xd.dst.y_stride
    );

    vp8_subtract_mby(x.src_diff.data, b.base_src.*, b.src_stride, xd.dst.y_buffer, xd.dst.y_stride);

    vp8_transform_intra_mby(x);

    vp8_quantize_mby(x);

    if x.optimize != 0 {
        vp8_optimize_mby(x);
    }
}

vp8_encode_intra16x16mbuv :: (x: *MACROBLOCK_in_block) {
    xd := *x.e_mbd;

    vp8_build_intra_predictors_mbuv_s(
        xd,
        xd.dst.u_buffer - xd.dst.uv_stride,
        xd.dst.v_buffer - xd.dst.uv_stride,
        xd.dst.u_buffer - 1,
        xd.dst.v_buffer - 1,
        xd.dst.uv_stride,
        xd.dst.u_buffer,
        xd.dst.v_buffer,
        xd.dst.uv_stride
    );

    vp8_subtract_mbuv(
        x.src_diff.data,
        x.src.u_buffer,
        x.src.v_buffer,
        x.src.uv_stride,
        xd.dst.u_buffer,
        xd.dst.v_buffer,
        xd.dst.uv_stride
    );

    vp8_transform_mbuv(x);

    vp8_quantize_mbuv(x);

    if x.optimize != 0 {
        vp8_optimize_mbuv(x);
    }
}

vp8_encode_intra4x4mby :: (mb: *MACROBLOCK_in_block) {
    xd := *mb.e_mbd;
    intra_prediction_down_copy_in_encodeintra(xd, xd.dst.y_buffer - xd.dst.y_stride + 16);

    for i: 0..cast(s32) 16 - 1 {
        vp8_encode_intra4x4block(mb, i);
    }
}

