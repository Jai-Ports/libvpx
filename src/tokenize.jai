}

vp8_atomic_spin_wait_in_tokenize :: (mb_col: s32, last_row_current_mb_col: *Atomic_Int, NSYNC: s32) {
    while mb_col > atomic_load_acquire_in_tokenize(last_row_current_mb_col) - NSYNC {
    }
}

mv_bias_in_tokenize :: (refmb_ref_frame_sign_bias: s32, refframe: s32, mvp: *Int_Mv_in_mv, ref_frame_sign_bias: *s32) {
    if refmb_ref_frame_sign_bias != ref_frame_sign_bias[refframe] {
        mvp.as_mv.row = cast,no_check(s16) ((cast,no_check(s32) mvp.as_mv.row) * -1);
        mvp.as_mv.col = cast,no_check(s16) ((cast,no_check(s32) mvp.as_mv.col) * -1);
    }
}

vp8_clamp_mv2_in_tokenize :: (mv: *Int_Mv_in_mv, xd: *MACROBLOCKD_in_blockd) {
    if cast,no_check(s32) mv.as_mv.col < xd.mb_to_left_edge - (cast(s32) 16) << 3 {
        mv.as_mv.col = cast,no_check(s16) (xd.mb_to_left_edge - (cast(s32) 16) << 3);
    } else if cast,no_check(s32) mv.as_mv.col > xd.mb_to_right_edge + (cast(s32) 16) << 3 {
        mv.as_mv.col = cast,no_check(s16) (xd.mb_to_right_edge + (cast(s32) 16) << 3);
    }

    if cast,no_check(s32) mv.as_mv.row < xd.mb_to_top_edge - (cast(s32) 16) << 3 {
        mv.as_mv.row = cast,no_check(s16) (xd.mb_to_top_edge - (cast(s32) 16) << 3);
    } else if cast,no_check(s32) mv.as_mv.row > xd.mb_to_bottom_edge + (cast(s32) 16) << 3 {
        mv.as_mv.row = cast,no_check(s16) (xd.mb_to_bottom_edge + (cast(s32) 16) << 3);
    }
}

vp8_clamp_mv_in_tokenize :: (
    mv: *Int_Mv_in_mv,
    mb_to_left_edge: s32,
    mb_to_right_edge: s32,
    mb_to_top_edge: s32,
    mb_to_bottom_edge: s32
) {
    mv.as_mv.col =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.col < mb_to_left_edge then mb_to_left_edge else cast,no_check(s32) mv.as_mv.col));
    mv.as_mv.col =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.col > mb_to_right_edge then mb_to_right_edge else cast,no_check(s32) mv.as_mv.col));
    mv.as_mv.row =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.row < mb_to_top_edge then mb_to_top_edge else cast,no_check(s32) mv.as_mv.row));
    mv.as_mv.row =
        cast,no_check(s16) ((ifx cast,no_check(s32) mv.as_mv.row > mb_to_bottom_edge then mb_to_bottom_edge else cast,no_check(s32) mv.as_mv.row));
}

vp8_check_mv_bounds_in_tokenize :: (
    mv: *Int_Mv_in_mv,
    mb_to_left_edge: s32,
    mb_to_right_edge: s32,
    mb_to_top_edge: s32,
    mb_to_bottom_edge: s32
) -> u32 {
    need_to_clamp := cast(u32) (cast,no_check(s32) mv.as_mv.col < mb_to_left_edge);
    need_to_clamp |= cast(u32) (cast,no_check(s32) mv.as_mv.col > mb_to_right_edge);
    need_to_clamp |= cast(u32) (cast,no_check(s32) mv.as_mv.row < mb_to_top_edge);
    need_to_clamp |= cast(u32) (cast,no_check(s32) mv.as_mv.row > mb_to_bottom_edge);
    return need_to_clamp;
}

left_block_mv_in_tokenize :: (cur_mb: *MODE_INFO_in_blockd, b: s32) -> u32 {
    if b & 3 == 0 {
        cur_mb -= 1;

        if cur_mb.mbmi.mode != cast,no_check(u8) SPLITMV {
            return cur_mb.mbmi.mv.as_int;
        }
        b += 4;
    }

    return (((cur_mb.bmi.data + b - 1)).mv).as_int;
}

above_block_mv_in_tokenize :: (cur_mb: *MODE_INFO_in_blockd, b: s32, mi_stride: s32) -> u32 {
    if b >> 2 == 0 {
        cur_mb -= mi_stride;

        if cur_mb.mbmi.mode != cast,no_check(u8) SPLITMV {
            return cur_mb.mbmi.mv.as_int;
        }
        b += 16;
    }

    return (((cur_mb.bmi.data + (b - 4))).mv).as_int;
}

left_block_mode_in_tokenize :: (cur_mb: *MODE_INFO_in_blockd, b: s32) -> B_PREDICTION_MODE {
    if b & 3 == 0 {
        cur_mb -= 1;
        if cast,no_check(s32) cur_mb.mbmi.mode == {
            case B_PRED;
                return ((cur_mb.bmi.data + b + 3)).as_mode;
            case DC_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
            case V_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_VE_PRED;
            case H_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_HE_PRED;
            case TM_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_TM_PRED;
            case;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
        }
    }

    return ((cur_mb.bmi.data + b - 1)).as_mode;
}

above_block_mode_in_tokenize :: (cur_mb: *MODE_INFO_in_blockd, b: s32, mi_stride: s32) -> B_PREDICTION_MODE {
    if b >> 2 == 0 {
        cur_mb -= mi_stride;

        if cast,no_check(s32) cur_mb.mbmi.mode == {
            case B_PRED;
                return ((cur_mb.bmi.data + b + 12)).as_mode;
            case DC_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
            case V_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_VE_PRED;
            case H_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_HE_PRED;
            case TM_PRED;
                return cast,no_check(B_PREDICTION_MODE) B_TM_PRED;
            case;
                return cast,no_check(B_PREDICTION_MODE) B_DC_PRED;
        }
    }

    return ((cur_mb.bmi.data + b - 4)).as_mode;
}

vp8_tokenize_mb :: (cpi: *VP8_COMP, x: *MACROBLOCK_in_block, t: **TOKENEXTRA) {
    xd := *x.e_mbd;

    has_y2_block :=
        cast(s32) (xd.mode_info_context.mbmi.mode != cast,no_check(u8) B_PRED &&
            xd.mode_info_context.mbmi.mode != cast,no_check(u8) SPLITMV);

    xd.mode_info_context.mbmi.mb_skip_coeff = cast,no_check(u8) mb_is_skippable(xd, has_y2_block);
    if xd.mode_info_context.mbmi.mb_skip_coeff != 0 {
        if cpi.common.mb_no_coeff_skip == 0 {
            vp8_stuff_mb(cpi, x, t);
        } else {
            vp8_fix_contexts(xd);
            x.skip_true_count += 1;
        }

        return;
    }

    plane_type: s32 = 3;
    if has_y2_block != 0 {
        tokenize2nd_order_b(x, t, cpi);
        plane_type = 0;
    }

    tokenize1st_order_b(x, t, plane_type, cpi);
}

tokenize1st_order_b :: (x: *MACROBLOCK_in_block, tp: **TOKENEXTRA, type: s32, cpi: *VP8_COMP) {
    xd := *x.e_mbd;

    pt: s32 = ---;
    c: s32 = ---;
    token: s32 = ---;
    t := tp.*;
    qcoeff_ptr: *s16 = ---;
    a: *ENTROPY_CONTEXT = ---;
    l: *ENTROPY_CONTEXT = ---;
    band, rc, v: s32 = ---;
    tmp1, tmp2: s32 = ---;

    b := xd.block.data;

    block: u32 = 0;
    while block < 16 {
        EOB := cast,no_check(s32) b.eob.*;
        tmp1 = cast,no_check(s32) VP8_BLOCK2ABOVE[block];
        tmp2 = cast,no_check(s32) VP8_BLOCK2LEFT[block];
        qcoeff_ptr = b.qcoeff;
        a = (cast(*ENTROPY_CONTEXT) xd.above_context) + tmp1;
        l = (cast(*ENTROPY_CONTEXT) xd.left_context) + tmp2;

        pt = (cast(s32) a.*) + cast(s32) l.*;

        c = ifx type != 0 then cast(s32) 0 else 1;

        if c >= EOB {
            t.token = 11;
            t.context_tree = cpi.common.fc.coef_probs[type][c][pt].data;
            t.skip_eob_node = 0;

            x.coef_counts[type][c][pt][11] += 1;
            t += 1;
            tp.* = t;
            l.* = 0;
            a.* = l.*;
            block += 1;
            b += 1;
            continue;
        }

        v = cast,no_check(s32) qcoeff_ptr[c];

        t.extra = VP8_DCT_VALUE_TOKENS_PTR[v].extra;
        token = cast,no_check(s32) VP8_DCT_VALUE_TOKENS_PTR[v].token;
        t.token = cast,no_check(u8) token;

        t.context_tree = cpi.common.fc.coef_probs[type][c][pt].data;
        t.skip_eob_node = 0;
        x.coef_counts[type][c][pt][token] += 1;
        pt = cast,no_check(s32) VP8_PREV_TOKEN_CLASS[token];
        t += 1;
        c += 1;

        while c < EOB {
            rc = VP8_DEFAULT_ZIG_ZAG1D[c];
            band = cast,no_check(s32) VP8_COEF_BANDS[c];
            v = cast,no_check(s32) qcoeff_ptr[rc];

            t.extra = VP8_DCT_VALUE_TOKENS_PTR[v].extra;
            token = cast,no_check(s32) VP8_DCT_VALUE_TOKENS_PTR[v].token;

            t.token = cast,no_check(u8) token;
            t.context_tree = cpi.common.fc.coef_probs[type][band][pt].data;

            t.skip_eob_node = cast(u8) (pt == 0);
            x.coef_counts[type][band][pt][token] += 1;

            pt = cast,no_check(s32) VP8_PREV_TOKEN_CLASS[token];
            t += 1;
            c += 1;
        }
        if c < 16 {
            band = cast,no_check(s32) VP8_COEF_BANDS[c];
            t.token = 11;
            t.context_tree = cpi.common.fc.coef_probs[type][band][pt].data;

            t.skip_eob_node = 0;
            x.coef_counts[type][band][pt][11] += 1;

            t += 1;
        }
        tp.* = t;
        l.* = 1;
        a.* = l.*;
        block += 1;
        b += 1;
    }

    block = 16;
    while block < 24 {
        EOB := cast,no_check(s32) b.eob.*;
        tmp1 = cast,no_check(s32) VP8_BLOCK2ABOVE[block];
        tmp2 = cast,no_check(s32) VP8_BLOCK2LEFT[block];
        qcoeff_ptr = b.qcoeff;
        a = (cast(*ENTROPY_CONTEXT) xd.above_context) + tmp1;
        l = (cast(*ENTROPY_CONTEXT) xd.left_context) + tmp2;

        pt = (cast(s32) a.*) + cast(s32) l.*;

        if EOB == 0 {
            t.token = 11;
            t.context_tree = cpi.common.fc.coef_probs[2][0][pt].data;
            t.skip_eob_node = 0;

            x.coef_counts[2][0][pt][11] += 1;
            t += 1;
            tp.* = t;
            l.* = 0;
            a.* = l.*;
            block += 1;
            b += 1;
            continue;
        }

        v = cast,no_check(s32) qcoeff_ptr[0];

        t.extra = VP8_DCT_VALUE_TOKENS_PTR[v].extra;
        token = cast,no_check(s32) VP8_DCT_VALUE_TOKENS_PTR[v].token;
        t.token = cast,no_check(u8) token;

        t.context_tree = cpi.common.fc.coef_probs[2][0][pt].data;
        t.skip_eob_node = 0;
        x.coef_counts[2][0][pt][token] += 1;
        pt = cast,no_check(s32) VP8_PREV_TOKEN_CLASS[token];
        t += 1;
        c = 1;

        while c < EOB {
            rc = VP8_DEFAULT_ZIG_ZAG1D[c];
            band = cast,no_check(s32) VP8_COEF_BANDS[c];
            v = cast,no_check(s32) qcoeff_ptr[rc];

            t.extra = VP8_DCT_VALUE_TOKENS_PTR[v].extra;
            token = cast,no_check(s32) VP8_DCT_VALUE_TOKENS_PTR[v].token;

            t.token = cast,no_check(u8) token;
            t.context_tree = cpi.common.fc.coef_probs[2][band][pt].data;

            t.skip_eob_node = cast(u8) (pt == 0);

            x.coef_counts[2][band][pt][token] += 1;

            pt = cast,no_check(s32) VP8_PREV_TOKEN_CLASS[token];
            t += 1;
            c += 1;
        }
        if c < 16 {
            band = cast,no_check(s32) VP8_COEF_BANDS[c];
            t.token = 11;
            t.context_tree = cpi.common.fc.coef_probs[2][band][pt].data;

            t.skip_eob_node = 0;

            x.coef_counts[2][band][pt][11] += 1;

            t += 1;
        }
        tp.* = t;
        l.* = 1;
        a.* = l.*;
        block += 1;
        b += 1;
    }
}

tokenize2nd_order_b :: (x: *MACROBLOCK_in_block, tp: **TOKENEXTRA, cpi: *VP8_COMP) {
    xd := *x.e_mbd;

    t := tp.*;
    band: s32 = ---;

    b := xd.block.data + 24;
    qcoeff_ptr := b.qcoeff;
    a := (cast(*ENTROPY_CONTEXT) xd.above_context) + 8;
    l := (cast(*ENTROPY_CONTEXT) xd.left_context) + 8;
    eob := cast,no_check(s32) xd.eobs[24];
    pt := (cast(s32) a.*) + cast(s32) l.*;

    if eob == 0 {
        t.token = 11;
        t.context_tree = cpi.common.fc.coef_probs[1][0][pt].data;
        t.skip_eob_node = 0;

        x.coef_counts[1][0][pt][11] += 1;
        t += 1;
        tp.* = t;
        l.* = 0;
        a.* = l.*;
        return;
    }

    v := cast,no_check(s32) qcoeff_ptr[0];
    t.extra = VP8_DCT_VALUE_TOKENS_PTR[v].extra;
    token := cast,no_check(s32) VP8_DCT_VALUE_TOKENS_PTR[v].token;
    t.token = cast,no_check(u8) token;

    t.context_tree = cpi.common.fc.coef_probs[1][0][pt].data;
    t.skip_eob_node = 0;
    x.coef_counts[1][0][pt][token] += 1;
    pt = cast,no_check(s32) VP8_PREV_TOKEN_CLASS[token];
    t += 1;
    c: s32 = 1;

    while c < eob {
        rc := VP8_DEFAULT_ZIG_ZAG1D[c];
        band = cast,no_check(s32) VP8_COEF_BANDS[c];
        v = cast,no_check(s32) qcoeff_ptr[rc];

        t.extra = VP8_DCT_VALUE_TOKENS_PTR[v].extra;
        token = cast,no_check(s32) VP8_DCT_VALUE_TOKENS_PTR[v].token;

        t.token = cast,no_check(u8) token;
        t.context_tree = cpi.common.fc.coef_probs[1][band][pt].data;

        t.skip_eob_node = cast(u8) (pt == 0);

        x.coef_counts[1][band][pt][token] += 1;

        pt = cast,no_check(s32) VP8_PREV_TOKEN_CLASS[token];
        t += 1;
        c += 1;
    }
    if c < 16 {
        band = cast,no_check(s32) VP8_COEF_BANDS[c];
        t.token = 11;
        t.context_tree = cpi.common.fc.coef_probs[1][band][pt].data;

        t.skip_eob_node = 0;

        x.coef_counts[1][band][pt][11] += 1;

        t += 1;
    }

    tp.* = t;
    l.* = 1;
    a.* = l.*;
}

vp8_fix_contexts :: (x: *MACROBLOCKD_in_blockd) {
    if x.mode_info_context.mbmi.mode != cast,no_check(u8) B_PRED && x.mode_info_context.mbmi.mode != cast,no_check(u8) SPLITMV {
        fill_memory(x.above_context, 0, size_of(ENTROPY_CONTEXT_PLANES));
        fill_memory(x.left_context, 0, size_of(ENTROPY_CONTEXT_PLANES));
    } else {
        fill_memory(x.above_context, 0, size_of(ENTROPY_CONTEXT_PLANES) - 1);
        fill_memory(x.left_context, 0, size_of(ENTROPY_CONTEXT_PLANES) - 1);
    }
}

vp8_stuff_mb :: (cpi: *VP8_COMP, x: *MACROBLOCK_in_block, t: **TOKENEXTRA) {
    xd := *x.e_mbd;
    a := cast(*ENTROPY_CONTEXT) xd.above_context;
    l := cast(*ENTROPY_CONTEXT) xd.left_context;

    plane_type: s32 = 3;
    if xd.mode_info_context.mbmi.mode != cast,no_check(u8) B_PRED &&
        xd.mode_info_context.mbmi.mode != cast,no_check(u8) SPLITMV {
        stuff2nd_order_b(
            t,
            a + cast,no_check(s32) VP8_BLOCK2ABOVE[24],
            l + cast,no_check(s32) VP8_BLOCK2LEFT[24],
            cpi,
            x
        );
        plane_type = 0;
    }

    for b: 0..cast(s32) 16 - 1 {
        stuff1st_order_b(
            t,
            a + cast,no_check(s32) VP8_BLOCK2ABOVE[b],
            l + cast,no_check(s32) VP8_BLOCK2LEFT[b],
            plane_type,
            cpi,
            x
        );
    }

    if 16 < 24 {
        for b: 16..cast(s32) 24 - 1 {
            stuff1st_order_buv(
                t,
                a + cast,no_check(s32) VP8_BLOCK2ABOVE[b],
                l + cast,no_check(s32) VP8_BLOCK2LEFT[b],
                cpi,
                x
            );
        }
    }
}

stuff1st_order_buv :: (
    tp: **TOKENEXTRA,
    a: *ENTROPY_CONTEXT,
    l: *ENTROPY_CONTEXT,
    cpi: *VP8_COMP,
    x: *MACROBLOCK_in_block
) {
    t := tp.*;
    pt := (cast(s32) a.*) + cast(s32) l.*;

    t.token = 11;
    t.context_tree = cpi.common.fc.coef_probs[2][0][pt].data;
    t.skip_eob_node = 0;
    x.coef_counts[2][0][pt][11] += 1;
    t += 1;
    tp.* = t;
    pt = 0;
    l.* = cast,no_check(ENTROPY_CONTEXT) pt;
    a.* = l.*;
}

stuff1st_order_b :: (
    tp: **TOKENEXTRA,
    a: *ENTROPY_CONTEXT,
    l: *ENTROPY_CONTEXT,
    type: s32,
    cpi: *VP8_COMP,
    x: *MACROBLOCK_in_block
) {
    t := tp.*;
    pt := (cast(s32) a.*) + cast(s32) l.*;
    band := (ifx type != 0 then cast(s32) 0 else 1);
    t.token = 11;
    t.context_tree = cpi.common.fc.coef_probs[type][band][pt].data;
    t.skip_eob_node = 0;
    x.coef_counts[type][band][pt][11] += 1;
    t += 1;
    tp.* = t;
    pt = 0;
    l.* = cast,no_check(ENTROPY_CONTEXT) pt;
    a.* = l.*;
}

stuff2nd_order_b :: (
    tp: **TOKENEXTRA,
    a: *ENTROPY_CONTEXT,
    l: *ENTROPY_CONTEXT,
    cpi: *VP8_COMP,
    x: *MACROBLOCK_in_block
) {
    t := tp.*;
    pt := (cast(s32) a.*) + cast(s32) l.*;

    t.token = 11;
    t.context_tree = cpi.common.fc.coef_probs[1][0][pt].data;
    t.skip_eob_node = 0;
    x.coef_counts[1][0][pt][11] += 1;
    t += 1;

    tp.* = t;
    pt = 0;
    l.* = cast,no_check(ENTROPY_CONTEXT) pt;
    a.* = l.*;
}

mb_is_skippable :: (x: *MACROBLOCKD_in_blockd, has_y2_block: s32) -> s32 {
    skip: s32 = 1;
    i: s32 = 0;

    if has_y2_block != 0 {
        i = 0;
        while i < 16 {
            skip &= cast(s32) (x.eobs[i] < 2);
            i += 1;
        }
    }

    while i < 24 + has_y2_block {
        skip &= cast(s32) (x.eobs[i] == 0);
        i += 1;
    }

    return skip;
}

globals_initialization_state_for_tokenize: u32;
initialize_globals_for_tokenize :: () {
    {
        state := atomic_load(*globals_initialization_state_for_tokenize);
        if state == 2 return;
        won, _ := compare_and_swap(*globals_initialization_state_for_tokenize, 0, 1);
        if !won {
            while atomic_load(*globals_initialization_state_for_tokenize) != 2 {}
            return;
