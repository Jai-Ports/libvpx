gcd_in_vp9_segmentation :: (a: s64, b: s32) -> s32 {
    while b != 0 {
        r := cast,no_check(s32) (a % cast(s64) b);
        a = cast,no_check(s64) b;
        b = r;
    }

    return cast,no_check(s32) a;
}

reduce_ratio_in_vp9_segmentation :: (ratio: *Rational64_T) {
    DENOM := gcd_in_vp9_segmentation(ratio.num, ratio.den);
    ratio.num /= cast,no_check(s64) DENOM;
    ratio.den /= DENOM;
}

cyclic_refresh_segment_id_boosted_in_vp9_segmentation :: (segment_id: s32) -> s32 {
    if segment_id == 1 || segment_id == 2 {
        return 1;
    }
    return 0;
}

cyclic_refresh_segment_id_in_vp9_segmentation :: (segment_id: s32) -> s32 {
    if segment_id == 1 {
        return 1;
    } else if segment_id == 2 {
        return 2;
    } else {
        return 0;
    }
}

fps_init_first_pass_info_in_vp9_segmentation :: (
    first_pass_info: *FIRST_PASS_INFO,
    stats: *FIRSTPASS_STATS_in_vp9_cx_iface,
    num_frames: s32
) {
    first_pass_info.stats = stats;
    first_pass_info.num_frames = num_frames;
}

fps_get_num_frames_in_vp9_segmentation :: (first_pass_info: *FIRST_PASS_INFO) -> s32 {
    return first_pass_info.num_frames;
}

fps_get_frame_stats_in_vp9_segmentation :: (
    first_pass_info: *FIRST_PASS_INFO,
    show_idx: s32
) -> *FIRSTPASS_STATS_in_vp9_cx_iface {
    if show_idx < 0 || show_idx >= first_pass_info.num_frames {
        return null;
    }
    return *(cast(*FIRSTPASS_STATS_in_vp9_cx_iface) (first_pass_info.stats))[show_idx];
}

get_buf_from_mv_in_vp9_segmentation :: (buf: *Buf_2d, mv: *MV) -> *u8 {
    return *buf.buf[(cast(s32) mv.row) * buf.stride + cast(s32) mv.col];
}

rd_less_than_thresh_in_vp9_segmentation :: (best_rd: s64, thresh: s32, THRESH_FACT: *s32) -> s32 {
    if best_rd < ((cast,no_check(s64) thresh) * cast(s64) THRESH_FACT.*) >> 5 || thresh == 2147483647 {
        return 1;
    }
    return 0;
}

set_error_per_bit_in_vp9_segmentation :: (x: *MACROBLOCK, rdmult: s32) {
    x.errorperbit = rdmult >> 6;
    x.errorperbit += cast(s32) (x.errorperbit == 0);
}

write_in_vp9_segmentation :: (br: *Writer, bit: s32, probability: s32) {
    count := br.count;
    range := br.range;
    lowvalue := br.lowvalue;

    split := 1 + ((range - 1) * cast,no_check(u32) probability) >> 8;

    range = split;

    if bit != 0 {
        lowvalue += split;
        range = br.range - split;
    }

    shift := cast,no_check(s32) NORM[range];

    c_transpiler_compound_shl(*(range), (((cast,no_check(u32) shift) & 31)), u32, u32);
    count += shift;

    if count >= 0 {
        offset := shift - count;

        if br.error == 0 {
            if lowvalue << (((offset - 1)) & 31) & 0x80000000 != 0 {
                x := (cast,no_check(s32) br.pos) - 1;

                while x >= 0 && br.buffer[x] == 0xff {
                    br.buffer[x] = 0;
                    x -= 1;
                }

                br.buffer[x] = cast,no_check(u8) ((cast,no_check(s32) br.buffer[x]) + 1);
            }

            if br.pos < br.size {
                br.buffer[br.pos] = cast,no_check(u8) (lowvalue >> (((24 - offset)) & 31) & 0xff);
                br.pos += 1;
            } else {
                br.error = 1;
            }
        }
        c_transpiler_compound_shl(*(lowvalue), (((cast,no_check(u32) offset) & 31)), u32, u32);
        shift = count;
        lowvalue &= 0xffffff;
        count -= 8;
    }

    c_transpiler_compound_shl(*(lowvalue), (((cast,no_check(u32) shift) & 31)), u32, u32);
    br.count = count;
    br.lowvalue = lowvalue;
    br.range = range;
}

write_bit_in_vp9_segmentation :: (w: *Writer, bit: s32) {
    write_in_vp9_segmentation(w, bit, 128);
}

write_literal_in_vp9_segmentation :: (w: *Writer, data: s32, bits: s32) {
    bit := bits - 1;
    while bit >= 0 {
        write_bit_in_vp9_segmentation(w, 1 & (data >> ((bit) & 31)));
        bit -= 1;
    }
}

vp9_write_tree_in_vp9_segmentation :: (
    w: *Writer,
    tree: *Tree_Index,
    probs: *Prob,
    bits: s32,
    len: s32,
    i: Tree_Index
) {
    while true {
        {
            BIT := bits >> ((c_transpiler_pre_decrement(*(len))) & 31) & 1;
            write_in_vp9_segmentation(w, BIT, cast,no_check(s32) probs[(cast(s32) i) >> 1]);
            i = tree[(cast(s32) i) + BIT];
        }
        if len == 0 break;
    }
}

vp9_write_token_in_vp9_segmentation :: (w: *Writer, tree: *Tree_Index, probs: *Prob, token: *Vp9_Token) {
    vp9_write_tree_in_vp9_segmentation(w, tree, probs, token.value, token.len, 0);
}

vp9_get_high_cost_table_in_vp9_segmentation :: (bit_depth: s32) -> *u16 {
    return VP9_CAT6_HIGH_COST.data;
}

vp9_get_token_extra_in_vp9_segmentation :: (v: s32, token: *s16, extra: *EXTRABIT) {
    if v >= 67 || v <= -67 {
        token.* = 10;
        if v >= 67 {
            extra.* = cast,no_check(EXTRABIT) (2 * v - cast,no_check(s32) ((2 * 67)));
        } else {
            extra.* = cast,no_check(EXTRABIT) ((-2 * v - cast,no_check(s32) ((2 * 67))) + 1);
        }
        return;
    }
    token.* = vp9_dct_cat_lt_10_value_tokens[v].token;
    extra.* = vp9_dct_cat_lt_10_value_tokens[v].extra;
}

vp9_get_token_in_vp9_segmentation :: (v: s32) -> s16 {
    if v >= 67 || v <= -67 {
        return 10;
    }
    return vp9_dct_cat_lt_10_value_tokens[v].token;
}

vp9_get_token_cost_in_vp9_segmentation :: (v: s32, token: *s16, cat6_high_table: *u16) -> s32 {
    if v >= 67 || v <= -67 {
        token.* = 10;
        extrabits := cast,no_check(EXTRABIT) (absolute_value(v) - 67);
        return (cast(s32) VP9_CAT6_LOW_COST[extrabits & 0xff]) + cast(s32) cat6_high_table[(cast(s32) extrabits) >> 8];
    }
    token.* = vp9_dct_cat_lt_10_value_tokens[v].token;
    return vp9_dct_cat_lt_10_value_cost[v];
}

is_lossless_requested_in_vp9_segmentation :: (cfg: *VP9_Encoder_Config) -> s32 {
    if cfg.best_allowed_q == 0 && cfg.worst_allowed_q == 0 {
        return 1;
    }
    return 0;
}

stack_pop_in_vp9_segmentation :: (stack: *s32, stack_size: s32) -> s32 {
    R := stack[0];
    if 1 < stack_size {
        for idx: 1..stack_size - 1 {
            stack[idx - 1] = stack[idx];
        }
    }

    return R;
}

stack_top_in_vp9_segmentation :: (stack: *s32) -> s32 {
    return stack[0];
}

stack_push_in_vp9_segmentation :: (stack: *s32, new_item: s32, stack_size: s32) {
    idx := stack_size;
    while idx > 0 {
        stack[idx] = stack[idx - 1];
        idx -= 1;
    }
    stack[0] = new_item;
}

stack_init_in_vp9_segmentation :: (stack: *s32, length: s32) {
    if 0 < length {
        for idx: 0..length - 1 {
            stack[idx] = -1;
        }
    }
}

frame_is_kf_gf_arf_in_vp9_segmentation :: (cpi: *VP9_COMP_in_vp9_encoder) -> s32 {
    if frame_is_intra_only_in_vp9_segmentation(*cpi.common) != 0 ||
        cpi.refresh_alt_ref_frame != 0 ||
        cpi.refresh_golden_frame != 0 && cpi.rc.is_src_frame_alt_ref == 0 {
        return 1;
    }
    return 0;
}

ref_frame_to_flag_in_vp9_segmentation :: (ref_frame: s8) -> s32 {

    return K_VP9_REF_FLAG_LIST_in_vp9_segmentation[ref_frame];
}

get_ref_frame_map_idx_in_vp9_segmentation :: (cpi: *VP9_COMP_in_vp9_encoder, ref_frame: MV_REFERENCE_FRAME) -> s32 {
    if ref_frame == 1 {
        return cpi.lst_fb_idx;
    } else if ref_frame == 2 {
        return cpi.gld_fb_idx;
    } else {
        return cpi.alt_fb_idx;
    }
}

get_ref_frame_buf_idx_in_vp9_segmentation :: (CPI: *VP9_COMP_in_vp9_encoder, ref_frame: s32) -> s32 {
    CM := *CPI.common;
    MAP_IDX := get_ref_frame_map_idx_in_vp9_segmentation(CPI, cast,no_check(MV_REFERENCE_FRAME) ref_frame);
    return ifx MAP_IDX != -1 then CM.ref_frame_map[MAP_IDX] else -1;
}

get_ref_cnt_buffer_in_vp9_segmentation :: (cm: *VP9_COMMON, fb_idx: s32) -> *Ref_Cnt_Buffer {
    return ifx fb_idx != -1 then cm.buffer_pool.frame_bufs.data + fb_idx else null;
}

get_ref_frame_bufs_in_vp9_segmentation :: (cpi: *VP9_COMP_in_vp9_encoder, ref_frame_bufs: **Ref_Cnt_Buffer) {
    CM := *cpi.common;

    ref_frame: MV_REFERENCE_FRAME = 1;
    while ref_frame < 4 {
        ref_frame_buf_idx := get_ref_frame_buf_idx_in_vp9_segmentation(cpi, cast,no_check(s32) ref_frame);
        inter_ref_idx := mv_ref_frame_to_inter_ref_idx_in_vp9_segmentation(ref_frame);
        ref_frame_bufs[inter_ref_idx] = get_ref_cnt_buffer_in_vp9_segmentation(CM, ref_frame_buf_idx);
        ref_frame += 1;
    }
}

get_ref_frame_buffer_in_vp9_segmentation :: (
    CPI: *VP9_COMP_in_vp9_encoder,
    ref_frame: MV_REFERENCE_FRAME
) -> *YV12_BUFFER_CONFIG {
    CM := *CPI.common;
    BUF_IDX := get_ref_frame_buf_idx_in_vp9_segmentation(CPI, cast,no_check(s32) ref_frame);
    return ifx BUF_IDX != -1 then *CM.buffer_pool.frame_bufs[BUF_IDX].buf else null;
}

get_token_alloc_in_vp9_segmentation :: (mb_rows: s32, mb_cols: s32) -> s64 {
    ALIGNED_MB_ROWS :=
        (mb_rows +
            ((cast(s32) 1) << ((((cast,no_check(s32) ((6 - 3))) - 1)) & 31) - 1)) & ~((cast(s32) 1) << ((((cast,no_check(s32) ((6 - 3))) - 1)) & 31) - 1);
    ALIGNED_MB_COLS :=
        (mb_cols +
            ((cast(s32) 1) << ((((cast,no_check(s32) ((6 - 3))) - 1)) & 31) - 1)) & ~((cast(s32) 1) << ((((cast,no_check(s32) ((6 - 3))) - 1)) & 31) - 1);
    return ((cast,no_check(s64) ALIGNED_MB_ROWS) * cast(s64) ALIGNED_MB_COLS) * cast,no_check(s64) ((cast,no_check(s32) ((16 * 16))) * 3 + 4);
}

allocated_tokens_in_vp9_segmentation :: (tile: Tile_Info) -> s64 {
    tile_mb_rows := (tile.mi_row_end - tile.mi_row_start + 1) >> 1;
    tile_mb_cols := (tile.mi_col_end - tile.mi_col_start + 1) >> 1;

    return get_token_alloc_in_vp9_segmentation(tile_mb_rows, tile_mb_cols);
}

get_start_tok_in_vp9_segmentation :: (
    cpi: *VP9_COMP_in_vp9_encoder,
    tile_row: s32,
    tile_col: s32,
    mi_row: s32,
    tok: **TOKENEXTRA_in_vp9_cx_iface
) {
    CM := *cpi.common;
    TILE_COLS := (cast(s32) 1) << ((CM.log2_tile_cols) & 31);
    this_tile := *cpi.tile_data[tile_row * TILE_COLS + tile_col];
    TILE_INFO := *this_tile.tile_info;

    tile_mb_cols := (TILE_INFO.mi_col_end - TILE_INFO.mi_col_start + 1) >> 1;
    MB_ROW := (mi_row - TILE_INFO.mi_row_start) >> 1;

    tok.* = cpi.tile_tok[tile_row][tile_col] + get_token_alloc_in_vp9_segmentation(MB_ROW, tile_mb_cols);
}

is_one_pass_svc_in_vp9_segmentation :: (CPI: *VP9_COMP_in_vp9_encoder) -> s32 {
    if CPI.use_svc != 0 && CPI.oxcf.pass == 0 {
        return 1;
    }
    return 0;
}

is_altref_enabled_in_vp9_segmentation :: (CPI: *VP9_COMP_in_vp9_encoder) -> s32 {
    if !(CPI.oxcf.mode == cast,no_check(u32) REALTIME && CPI.oxcf.rc_mode == cast,no_check(u32) CBR) &&
        CPI.oxcf.lag_in_frames >= 4 &&
        CPI.oxcf.enable_auto_arf != 0 {
        return 1;
    }
    return 0;
}

set_ref_ptrs_in_vp9_segmentation :: (
    CM: *VP9_COMMON,
    xd: *MACROBLOCKD,
    ref0: MV_REFERENCE_FRAME,
    ref1: MV_REFERENCE_FRAME
) {
    xd.block_refs[0] = CM.frame_refs.data + (ifx ref0 >= 1 then (cast(s32) ref0) - 1 else 0);
    xd.block_refs[1] = CM.frame_refs.data + (ifx ref1 >= 1 then (cast(s32) ref1) - 1 else 0);
}

get_chessboard_index_in_vp9_segmentation :: (FRAME_INDEX: s32) -> s32 {
    return FRAME_INDEX & 0x1;
}

cond_cost_list_in_vp9_segmentation :: (cpi: *VP9_COMP_in_vp9_encoder, cost_list: *s32) -> *s32 {
    return ifx cpi.sf.mv.subpel_search_method != cast,no_check(u32) SUBPEL_TREE then cost_list else null;
}

get_num_vert_units_in_vp9_segmentation :: (tile: Tile_Info, shift: s32) -> s32 {
    num_vert_units := (tile.mi_row_end - tile.mi_row_start + (cast(s32) 1) << ((shift) & 31) - 1) >> ((shift) & 31);
    return num_vert_units;
}

get_num_cols_in_vp9_segmentation :: (tile: Tile_Info, shift: s32) -> s32 {
    num_cols := (tile.mi_col_end - tile.mi_col_start + (cast(s32) 1) << ((shift) & 31) - 1) >> ((shift) & 31);
    return num_cols;
}

get_level_index_in_vp9_segmentation :: (level: VP9_LEVEL) -> s32 {
    for i: 0..cast(s32) 14 - 1 {
        if level == VP9_LEVEL_DEFS[i].level {
            return i;
        }
    }
    return -1;
}

log_tile_cols_from_picsize_level_in_vp9_segmentation :: (width: u32, height: u32) -> s32 {
    PIC_SIZE := width * height;
    PIC_BREADTH := max(width, height);
    for i: 0..cast(s32) 14 - 1 {
        if VP9_LEVEL_DEFS[i].max_luma_picture_size >= PIC_SIZE && VP9_LEVEL_DEFS[i].max_luma_picture_breadth >= PIC_BREADTH {
            return get_msb_in_vp9_segmentation(cast,no_check(u32) VP9_LEVEL_DEFS[i].max_col_tiles);
        }
    }
    return 2147483647;
}

alloc_frame_mvs_in_vp9_segmentation :: (CM: *VP9_COMMON, buffer_idx: s32) {
    NEW_FB_PTR := CM.buffer_pool.frame_bufs.data + buffer_idx;
    if NEW_FB_PTR.mvs == null || NEW_FB_PTR.mi_rows < CM.mi_rows || NEW_FB_PTR.mi_cols < CM.mi_cols {
        deallocate_memory(cast(*void) NEW_FB_PTR.mvs);
        NEW_FB_PTR.mvs =
            cast(*MV_REF) calloc_2(
                cast,no_check(u64) (CM.mi_rows * CM.mi_cols),
                size_of(MV_REF)
            );

        if NEW_FB_PTR.mvs == null {
            internal_error(
                *CM.error,
                cast,no_check(Codec_Err_T) CODEC_MEM_ERROR,
                c_string("Failed to allocate new_fb_ptr->mvs")
            );
        }
        NEW_FB_PTR.mi_rows = CM.mi_rows;
        NEW_FB_PTR.mi_cols = CM.mi_cols;
    }
}

mv_cost_in_vp9_segmentation :: (mv: *MV, joint_cost: *s32, comp_cost: **s32) -> s32 {
    return joint_cost[vp9_get_mv_joint_in_vp9_segmentation(mv)] + comp_cost[0][mv.row] + comp_cost[1][mv.col];
}

mvsad_err_cost_in_vp9_segmentation :: (x: *MACROBLOCK, mv: *MV, ref: *MV, sad_per_bit: s32) -> s32 {
    diff: MV = ---;
    diff.row = cast,no_check(s16) ((cast(s32) mv.row) - cast(s32) ref.row);
    diff.col = cast,no_check(s16) ((cast(s32) mv.col) - cast(s32) ref.col);
    return cast,no_check(s32) ((((cast,no_check(u32) mv_cost_in_vp9_segmentation(*diff, x.nmvjointsadcost.data, x.nmvsadcost.data)) * cast,no_check(u32) sad_per_bit) + cast,no_check(u32) ((cast(s32) 1) << (((9 - 1)) & 31))) >> 9);
}

get_start_mv_sad_in_vp9_segmentation :: (
    x: *MACROBLOCK,
    mvp_full: *MV,
    ref_mv_full: *MV,
    sad_fn_ptr: Sad_Fn_T,
    sadpb: s32
) -> u32 {
    SRC_BUF_STRIDE := x.plane[0].src.stride;
    SRC_BUF := x.plane[0].src.buf;
    XD := *x.e_mbd;
    PRED_BUF_STRIDE := XD.plane[0].pre[0].stride;
    PRED_BUF := XD.plane[0].pre[0].buf + (cast(s32) mvp_full.row) * PRED_BUF_STRIDE + cast,no_check(s32) mvp_full.col;
    start_mv_sad: u32 = sad_fn_ptr(SRC_BUF, SRC_BUF_STRIDE, PRED_BUF, PRED_BUF_STRIDE);
    start_mv_sad += cast,no_check(u32) mvsad_err_cost_in_vp9_segmentation(x, mvp_full, ref_mv_full, sadpb);

    return start_mv_sad;
}

num_4x4_to_edge_in_vp9_segmentation :: (
    plane_4x4_dim: s32,
    mb_to_edge_dim: s32,
    subsampling_dim: s32,
    blk_dim: s32
) -> s32 {
    return plane_4x4_dim + mb_to_edge_dim >> (((5 + subsampling_dim)) & 31) - blk_dim;
}

sum_squares_visible_in_vp9_segmentation :: (
    xd: *MACROBLOCKD,
    PD: *Macroblockd_Plane,
    diff: *s16,
    DIFF_STRIDE: s32,
    blk_row: s32,
    blk_col: s32,
    PLANE_BSIZE: BLOCK_SIZE,
    TX_BSIZE: BLOCK_SIZE,
    visible_width: *s32,
    visible_height: *s32
) -> s64 {
    sse: s64 = ---;
    PLANE_4X4_W := cast,no_check(s32) NUM_4X4_BLOCKS_WIDE_LOOKUP[PLANE_BSIZE];
    PLANE_4X4_H := cast,no_check(s32) NUM_4X4_BLOCKS_HIGH_LOOKUP[PLANE_BSIZE];
    TX_4X4_W := cast,no_check(s32) NUM_4X4_BLOCKS_WIDE_LOOKUP[TX_BSIZE];
    TX_4X4_H := cast,no_check(s32) NUM_4X4_BLOCKS_HIGH_LOOKUP[TX_BSIZE];
    B4X4S_TO_RIGHT_EDGE :=
        num_4x4_to_edge_in_vp9_segmentation(
            PLANE_4X4_W,
            xd.mb_to_right_edge,
            PD.subsampling_x,
            blk_col
        );
    B4X4S_TO_BOTTOM_EDGE :=
        num_4x4_to_edge_in_vp9_segmentation(
            PLANE_4X4_H,
            xd.mb_to_bottom_edge,
            PD.subsampling_y,
            blk_row
        );
    if TX_BSIZE == 0 || B4X4S_TO_RIGHT_EDGE >= TX_4X4_W && B4X4S_TO_BOTTOM_EDGE >= TX_4X4_H {
        sse = cast,no_check(s64) sum_squares_2d_i16_c(diff, DIFF_STRIDE, TX_4X4_W << 2);
        visible_width.* = TX_4X4_W << 2;
        visible_height.* = TX_4X4_H << 2;
    } else {
        c: s32 = ---;
        MAX_R := min(B4X4S_TO_BOTTOM_EDGE, TX_4X4_H);
        MAX_C := min(B4X4S_TO_RIGHT_EDGE, TX_4X4_W);
        sse = 0;

        if 0 < MAX_R {
            for r: 0..MAX_R - 1 {
                c = 0;
                while c < MAX_C {
                    sse +=
                        cast,no_check(s64) sum_squares_2d_i16_c(
                            diff + r * DIFF_STRIDE * 4 + c * 4,
                            DIFF_STRIDE,
                            4
                        );
                    c += 1;
                }
            }
        }
        visible_width.* = MAX_C << 2;
        visible_height.* = MAX_R << 2;
    }
    return sse;
}

do_trellis_opt_in_vp9_segmentation :: (
    pd: *Macroblockd_Plane,
    src_diff: *s16,
    diff_stride: s32,
    blk_row: s32,
    blk_col: s32,
    plane_bsize: BLOCK_SIZE,
    tx_size: TX_SIZE,
    arg: *void
) -> s32 {
    ARGS := cast(*Encode_B_Args) arg;
    X := ARGS.x;

    if ARGS.enable_trellis_opt == {
        case DISABLE_TRELLIS_OPT;
            return 0;
        case ENABLE_TRELLIS_OPT;
            return 1;
        case ENABLE_TRELLIS_OPT_TX_RD_SRC_VAR;
            {
                return ifx c_transpiler_float_greater(ARGS.trellis_opt_thresh, 0.0) then cast(s32) (c_transpiler_float_less_equal(X.log_block_src_var, ARGS.trellis_opt_thresh)) else 1;
            }
        case ENABLE_TRELLIS_OPT_TX_RD_RESIDUAL_MSE;
            {
                XD := *X.e_mbd;
                TX_BSIZE := TXSIZE_TO_BSIZE[tx_size];

                DEQUANT_SHIFT: s32 = 3;

                QSTEP := (cast(s32) pd.dequant[1]) >> ((DEQUANT_SHIFT) & 31);
                sse_calc_done := ARGS.sse_calc_done;
                sse := ARGS.sse;
                visible_width: s32 = 0;
                visible_height: s32 = 0;

                if XD.cur_buf.flags & 8 != 0 || sse == null || sse_calc_done == null {
                    return 1;
                }

                sse.* =
                    sum_squares_visible_in_vp9_segmentation(
                        XD,
                        pd,
                        src_diff,
                        diff_stride,
                        blk_row,
                        blk_col,
                        plane_bsize,
                        TX_BSIZE,
                        *visible_width,
                        *visible_height
                    );
                sse_calc_done.* = 1;

                if c_transpiler_float_less_equal(cast,no_check(float64) sse.*, (((((cast,no_check(s64) visible_width) * cast(s64) visible_height) * cast(s64) QSTEP) * cast(s64) QSTEP) * ARGS.trellis_opt_thresh)) {
                    return 1;
                }
                return 0;
            }
        case;
            return 1;
    }
    return unreachable_value(s32);
}

vp9_enable_segmentation :: (seg: *Segmentation) {
    seg.enabled = 1;
    seg.update_map = 1;
    seg.update_data = 1;
}

vp9_disable_segmentation :: (seg: *Segmentation) {
    seg.enabled = 0;
    seg.update_map = 0;
    seg.update_data = 0;
}

vp9_disable_segfeature :: (seg: *Segmentation, segment_id: s32, feature_id: SEG_LVL_FEATURES) {
    seg.feature_mask[segment_id] = cast,no_check(u32) (seg.feature_mask[segment_id] & ~((cast(u32) 1) << ((feature_id) & 31)));
}

vp9_clear_segdata :: (seg: *Segmentation, segment_id: s32, feature_id: SEG_LVL_FEATURES) {
    seg.feature_data[segment_id][feature_id] = 0;
}

vp9_psnr_aq_mode_setup :: (seg: *Segmentation) {
    vp9_enable_segmentation(seg);
    vp9_clearall_segfeatures(seg);
    seg.abs_delta = 0;

    for i: 0..cast(s32) 8 - 1 {
        vp9_set_segdata(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q, 2 * (i - cast,no_check(s32) ((8 / 2))));
        vp9_enable_segfeature(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q);
    }
}

vp9_perceptual_aq_mode_setup :: (cpi: *VP9_COMP_in_vp9_encoder, seg: *Segmentation) {
    cm := *cpi.common;
    SEG_COUNTS := cpi.kmeans_ctr_num;
    BASE_QINDEX := cm.base_qindex;
    BASE_QSTEP := vp9_convert_qindex_to_q(BASE_QINDEX, cm.bit_depth);
    MID_CTR := cpi.kmeans_ctr_ls[SEG_COUNTS / 2];
    VAR_DIFF_SCALE: float64 = 4.0;

    vp9_enable_segmentation(seg);
    vp9_clearall_segfeatures(seg);
    seg.abs_delta = 0;

    i: s32 = 0;
    while i < SEG_COUNTS / 2 {
        wiener_var_diff := MID_CTR - cpi.kmeans_ctr_ls[i];
        target_qstep := BASE_QSTEP / (1.0 + wiener_var_diff / 4.0);
        target_qindex := vp9_convert_q_to_qindex(target_qstep, cm.bit_depth);

        vp9_set_segdata(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q, target_qindex - BASE_QINDEX);
        vp9_enable_segfeature(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q);
        i += 1;
    }

    vp9_set_segdata(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q, 0);
    vp9_enable_segfeature(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q);

    while i < SEG_COUNTS {
        wiener_var_diff := cpi.kmeans_ctr_ls[i] - MID_CTR;
        target_qstep := BASE_QSTEP * (1.0 + wiener_var_diff / 4.0);
        target_qindex := vp9_convert_q_to_qindex(target_qstep, cm.bit_depth);

        vp9_set_segdata(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q, target_qindex - BASE_QINDEX);
        vp9_enable_segfeature(seg, i, cast,no_check(SEG_LVL_FEATURES) SEG_LVL_ALT_Q);
        i += 1;
    }
}

vp9_set_segment_data :: (seg: *Segmentation, feature_data: *s8, abs_delta: u8) {
    seg.abs_delta = abs_delta;

    copy_memory(seg.feature_data.data, feature_data, seg.feature_data.count * size_of([4] s16));
}

vp9_choose_segmap_coding_method :: (cm: *VP9_COMMON, xd: *MACROBLOCKD) {
    seg := *cm.seg;

    t_pred_cost: s32 = 2147483647;
    mi_row: s32 = ---;
    mi_col: s32 = ---;

    temporal_predictor_count: [3] [2] s32;
    no_pred_segcounts: [8] s32;
    t_unpred_seg_counts: [8] s32;

    no_pred_tree: [7] Prob = ---;
    t_pred_tree: [7] Prob = ---;
    t_nopred_prob: [3] Prob = ---;

    fill_memory(seg.tree_probs.data, 255, seg.tree_probs.count);
    fill_memory(seg.pred_probs.data, 255, seg.pred_probs.count);

    tile_col: s32 = 0;
    while tile_col < (cast(s32) 1) << ((cm.log2_tile_cols) & 31) {
        tile: Tile_Info = ---;

        vp9_tile_init(*tile, cm, 0, tile_col);

        mi_ptr := cm.mi_grid_visible + tile.mi_col_start;
        mi_row = 0;
        while mi_row < cm.mi_rows {
            mi := mi_ptr;
            mi_col = tile.mi_col_start;
            while mi_col < tile.mi_col_end {
                count_segs_sb(
                    cm,
                    xd,
                    *tile,
                    mi,
                    no_pred_segcounts.data,
                    temporal_predictor_count.data,
                    t_unpred_seg_counts.data,
                    mi_row,
                    mi_col,
                    12
                );
                mi_col += 8;
                mi += 8;
            }
            mi_row += 8;
            mi_ptr += 8 * cm.mi_stride;
        }
        tile_col += 1;
    }

    calc_segtree_probs(no_pred_segcounts.data, no_pred_tree.data);
    no_pred_cost := cost_segmap(no_pred_segcounts.data, no_pred_tree.data);

    if frame_is_intra_only_in_vp9_segmentation(cm) == 0 {
        calc_segtree_probs(t_unpred_seg_counts.data, t_pred_tree.data);
        t_pred_cost = cost_segmap(t_unpred_seg_counts.data, t_pred_tree.data);

        for i: 0..cast(s32) 3 - 1 {
            COUNT0 := temporal_predictor_count[i][0];
            COUNT1 := temporal_predictor_count[i][1];

            t_nopred_prob[i] =
                get_binary_prob_in_vp9_segmentation(cast,no_check(u32) COUNT0, cast,no_check(u32) COUNT1);

            t_pred_cost +=
                (COUNT0 * cast(s32) VP9_PROB_COST[t_nopred_prob[i]]) +
                    COUNT1 * cast(s32) VP9_PROB_COST[256 - cast(s32) t_nopred_prob[i]];
        }
    }

    if t_pred_cost < no_pred_cost {
        seg.temporal_update = 1;
        copy_memory(seg.tree_probs.data, t_pred_tree.data, t_pred_tree.count);
        copy_memory(seg.pred_probs.data, t_nopred_prob.data, t_nopred_prob.count);
    } else {
        seg.temporal_update = 0;
        copy_memory(seg.tree_probs.data, no_pred_tree.data, no_pred_tree.count);
    }
}

cost_segmap :: (segcounts: *s32, probs: *Prob) -> s32 {
    C01 := segcounts[0] + segcounts[1];
    C23 := segcounts[2] + segcounts[3];
    C45 := segcounts[4] + segcounts[5];
    C67 := segcounts[6] + segcounts[7];
    C0123 := C01 + C23;
    C4567 := C45 + C67;

    cost := (C0123 * cast(s32) VP9_PROB_COST[probs[0]]) + C4567 * cast(s32) VP9_PROB_COST[256 - cast(s32) probs[0]];

    if C0123 > 0 {
        cost += (C01 * cast(s32) VP9_PROB_COST[probs[1]]) + C23 * cast(s32) VP9_PROB_COST[256 - cast(s32) probs[1]];

        if C01 > 0 {
            cost +=
                (segcounts[0] * cast(s32) VP9_PROB_COST[probs[3]]) +
                    segcounts[1] * cast(s32) VP9_PROB_COST[256 - cast(s32) probs[3]];
        }
        if C23 > 0 {
            cost +=
                (segcounts[2] * cast(s32) VP9_PROB_COST[probs[4]]) +
                    segcounts[3] * cast(s32) VP9_PROB_COST[256 - cast(s32) probs[4]];
        }
    }

    if C4567 > 0 {
        cost += (C45 * cast(s32) VP9_PROB_COST[probs[2]]) + C67 * cast(s32) VP9_PROB_COST[256 - cast(s32) probs[2]];

        if C45 > 0 {
            cost +=
                (segcounts[4] * cast(s32) VP9_PROB_COST[probs[5]]) +
                    segcounts[5] * cast(s32) VP9_PROB_COST[256 - cast(s32) probs[5]];
        }
        if C67 > 0 {
            cost +=
                (segcounts[6] * cast(s32) VP9_PROB_COST[probs[6]]) +
                    segcounts[7] * cast(s32) VP9_PROB_COST[256 - cast(s32) probs[6]];
        }
    }

    return cost;
}

calc_segtree_probs :: (segcounts: *s32, segment_tree_probs: *Prob) {
    C01 := segcounts[0] + segcounts[1];
    C23 := segcounts[2] + segcounts[3];
    C45 := segcounts[4] + segcounts[5];
    C67 := segcounts[6] + segcounts[7];

    segment_tree_probs[0] =
        get_binary_prob_in_vp9_segmentation(
            cast,no_check(u32) (C01 + C23),
            cast,no_check(u32) (C45 + C67)
        );
    segment_tree_probs[1] = get_binary_prob_in_vp9_segmentation(cast,no_check(u32) C01, cast,no_check(u32) C23);
    segment_tree_probs[2] = get_binary_prob_in_vp9_segmentation(cast,no_check(u32) C45, cast,no_check(u32) C67);
    segment_tree_probs[3] =
        get_binary_prob_in_vp9_segmentation(
            cast,no_check(u32) segcounts[0],
            cast,no_check(u32) segcounts[1]
        );
    segment_tree_probs[4] =
        get_binary_prob_in_vp9_segmentation(
            cast,no_check(u32) segcounts[2],
            cast,no_check(u32) segcounts[3]
        );
    segment_tree_probs[5] =
        get_binary_prob_in_vp9_segmentation(
            cast,no_check(u32) segcounts[4],
            cast,no_check(u32) segcounts[5]
        );
    segment_tree_probs[6] =
        get_binary_prob_in_vp9_segmentation(
            cast,no_check(u32) segcounts[6],
            cast,no_check(u32) segcounts[7]
        );
}

count_segs_sb :: (
    cm: *VP9_COMMON,
    xd: *MACROBLOCKD,
    tile: *Tile_Info,
    mi: **MODE_INFO,
    no_pred_segcounts: *s32,
    temporal_predictor_count: *[2] s32,
    t_unpred_seg_counts: *s32,
    mi_row: s32,
    mi_col: s32,
    bsize: BLOCK_SIZE
) {
    MIS := cm.mi_stride;

    BS := cast,no_check(s32) NUM_8X8_BLOCKS_WIDE_LOOKUP[bsize];
    HBS := BS / 2;

    if mi_row >= cm.mi_rows || mi_col >= cm.mi_cols {
        return;
    }

    bw := cast,no_check(s32) NUM_8X8_BLOCKS_WIDE_LOOKUP[mi[0].sb_type];
    bh := cast,no_check(s32) NUM_8X8_BLOCKS_HIGH_LOOKUP[mi[0].sb_type];

    if bw == BS && bh == BS {
        count_segs(
            cm,
            xd,
            tile,
            mi,
            no_pred_segcounts,
            temporal_predictor_count,
            t_unpred_seg_counts,
            BS,
            BS,
            mi_row,
            mi_col
        );
    } else if bw == BS && bh < BS {
        count_segs(
            cm,
            xd,
            tile,
            mi,
            no_pred_segcounts,
            temporal_predictor_count,
            t_unpred_seg_counts,
            BS,
            HBS,
            mi_row,
            mi_col
        );
        count_segs(
            cm,
            xd,
            tile,
            mi + HBS * MIS,
            no_pred_segcounts,
            temporal_predictor_count,
            t_unpred_seg_counts,
            BS,
            HBS,
            mi_row + HBS,
            mi_col
        );
    } else if bw < BS && bh == BS {
        count_segs(
            cm,
            xd,
            tile,
            mi,
            no_pred_segcounts,
            temporal_predictor_count,
            t_unpred_seg_counts,
            HBS,
            BS,
            mi_row,
            mi_col
        );
        count_segs(
            cm,
            xd,
            tile,
            mi + HBS,
            no_pred_segcounts,
            temporal_predictor_count,
            t_unpred_seg_counts,
            HBS,
            BS,
            mi_row,
            mi_col + HBS
        );
    } else {
        SUBSIZE := SUBSIZE_LOOKUP[PARTITION_SPLIT][bsize];

        for n: 0..cast(s32) 4 - 1 {
            MI_DC := HBS * n & 1;
            MI_DR := HBS * n >> 1;

            count_segs_sb(
                cm,
                xd,
                tile,
                *mi[MI_DR * MIS + MI_DC],
                no_pred_segcounts,
                temporal_predictor_count,
                t_unpred_seg_counts,
                mi_row + MI_DR,
                mi_col + MI_DC,
                SUBSIZE
            );
        }
    }
}

count_segs :: (
    cm: *VP9_COMMON,
    xd: *MACROBLOCKD,
    tile: *Tile_Info,
    mi: **MODE_INFO,
    no_pred_segcounts: *s32,
    temporal_predictor_count: *[2] s32,
    t_unpred_seg_counts: *s32,
    bw: s32,
    bh: s32,
    mi_row: s32,
    mi_col: s32
) {
    if mi_row >= cm.mi_rows || mi_col >= cm.mi_cols {
        return;
    }

    xd.mi = mi;
    segment_id := cast,no_check(s32) xd.mi[0].segment_id;

    set_mi_row_col_in_vp9_segmentation(xd, tile, mi_row, bh, mi_col, bw, cm.mi_rows, cm.mi_cols);

    no_pred_segcounts[segment_id] += 1;

    if cm.frame_type != cast,no_check(u32) KEY_FRAME {
        BSIZE := xd.mi[0].sb_type;

        PRED_SEGMENT_ID := get_segment_id_in_vp9_segmentation(cm, cm.last_frame_seg_map, BSIZE, mi_row, mi_col);
        PRED_FLAG := cast(s32) (PRED_SEGMENT_ID == segment_id);
        PRED_CONTEXT := vp9_get_pred_context_seg_id_in_vp9_segmentation(xd);

        xd.mi[0].seg_id_predicted = cast,no_check(s8) PRED_FLAG;
        temporal_predictor_count[PRED_CONTEXT][PRED_FLAG] += 1;

        if PRED_FLAG == 0 {
            t_unpred_seg_counts[segment_id] += 1;
        }
    }
}

vp9_reset_segment_features :: (seg: *Segmentation) {
    seg.enabled = 0;
    seg.update_map = 0;
    seg.update_data = 0;
    fill_memory(seg.tree_probs.data, 255, seg.tree_probs.count);
    vp9_clearall_segfeatures(seg);
}

globals_initialization_state_for_vp9_segmentation: u32;
initialize_globals_for_vp9_segmentation :: () {
    {
        state := atomic_load(*globals_initialization_state_for_vp9_segmentation);
        if state == 2 return;
        won, _ := compare_and_swap(*globals_initialization_state_for_vp9_segmentation, 0, 1);
        if !won {
            while atomic_load(*globals_initialization_state_for_vp9_segmentation) != 2 {}
            return;
        }
    }
    COUNT_TO_UPDATE_FACTOR_in_vp9_segmentation =
        s32.[
            0,
            6,
            12,
            19,
            25,
            32,
            38,
            44,
            51,
            57,
            64,
            70,
            76,
            83,
            89,
            96,
            102,
            108,
            115,
            121,
            128
        ];
    SUB_PEL_FILTERS_12_in_vp9_segmentation =
        Interp_Kernel12.[
            s16.[ 0, 0, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0 ],
            s16.[ 0, 1, -2, 3, -7, 127, 8, -4, 2, -1, 1, 0 ],
            s16.[ -1, 2, -3, 6, -13, 124, 18, -8, 4, -2, 2, -1 ],
            s16.[ -1, 3, -4, 8, -18, 120, 28, -12, 7, -4, 2, -1 ],
            s16.[ -1, 3, -6, 10, -21, 115, 38, -15, 8, -5, 3, -1 ],
            s16.[ -2, 4, -6, 12, -24, 108, 49, -18, 10, -6, 3, -2 ],
            s16.[ -2, 4, -7, 13, -25, 100, 60, -21, 11, -7, 4, -2 ],
            s16.[ -2, 4, -7, 13, -26, 91, 71, -24, 13, -7, 4, -2 ],
            s16.[ -2, 4, -7, 13, -25, 81, 81, -25, 13, -7, 4, -2 ],
            s16.[ -2, 4, -7, 13, -24, 71, 91, -26, 13, -7, 4, -2 ],
            s16.[ -2, 4, -7, 11, -21, 60, 100, -25, 13, -7, 4, -2 ],
            s16.[ -2, 3, -6, 10, -18, 49, 108, -24, 12, -6, 4, -2 ],
            s16.[ -1, 3, -5, 8, -15, 38, 115, -21, 10, -6, 3, -1 ],
            s16.[ -1, 2, -4, 7, -12, 28, 120, -18, 8, -4, 3, -1 ],
            s16.[ -1, 2, -2, 4, -8, 18, 124, -13, 6, -3, 2, -1 ],
            s16.[ 0, 1, -1, 2, -4, 8, 127, -7, 3, -2, 1, 0 ]
        ];
    K_VP9_REF_FLAG_LIST_in_vp9_segmentation =
        s32.[ 0, cast,no_check(s32) (VP9_LAST_FLAG), cast,no_check(s32) (VP9_GOLD_FLAG), cast,no_check(s32) (VP9_ALT_FLAG) ];
    FRAME_SCALE_FACTOR_in_vp9_segmentation = s32.[ 16, 24 ];
    RATE_THRESH_MULT_in_vp9_segmentation = float64.[ 1.0, 2.0 ];
    RCF_MULT_in_vp9_segmentation = float64.[ 1.0, 2.0 ];
    atomic_store(*globals_initialization_state_for_vp9_segmentation, 2);
}

